# ==============================================================================
# STUDENT ID CARD STUDIO — AI DESIGN INTELLIGENCE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local to configure your Google Gemini API key.
# This project uses Gemini's text generation API and renders all visual
# layouts, backgrounds, and graphics 100% locally via mathematical SVG and CSS.
# Zero paid image-generation APIs (no FLUX or external image credits required).
# ==============================================================================

# Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model (defaults to gemini-3.1-flash-lite if omitted)
# Supported models: gemini-3.1-flash-lite, gemini-3.8-flash
GEMINI_MODEL=gemini-3.1-flash-lite
